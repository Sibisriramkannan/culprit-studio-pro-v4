NVIDIA_COSMOS_INFER_PATH=/infer
NVIDIA_COSMOS_RESOLUTION=720_16_9
NVIDIA_COSMOS_NUM_FRAMES=97
NVIDIA_COSMOS_FPS=24
NVIDIA_COSMOS_STEPS=35
NVIDIA_COSMOS_GUIDANCE=4.0
NVIDIA_COSMOS_TIMEOUT=900

